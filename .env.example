# Database
DB_URL=jdbc:postgresql://postgres:5432/expense_db
DB_USERNAME=expense_user
DB_PASSWORD=expense_pass

# JWT — CHANGE THIS IN PRODUCTION (min 32 chars, use a random secret)
JWT_SECRET=YourSuperSecretKeyForProductionUseMinimum32Chars
JWT_ACCESS_EXPIRY=900000

# File storage
UPLOAD_DIR=/app/uploads

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Docker Hub (for CI/CD)
# DOCKER_USERNAME=your_dockerhub_username
# DOCKER_PASSWORD=your_dockerhub_password
